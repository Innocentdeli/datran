{
  "build": {
    "beforeDevCommand": "npm --prefix ../diocom-app run dev -- -p 3001",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:3001",
    "distDir": "http://localhost:3001"
  },
  "package": {
    "productName": "Datran",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "clipboard": {
        "all": false,
        "writeText": true,
        "readText": false
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "io.diocom.datran",
      "longDescription": "Desktop shell for the Datran file-sharing portal.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "Datran file sharing.",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self' http://localhost:3001; connect-src 'self' http://localhost:3001 ws://localhost:3001; img-src 'self' data: blob: http://localhost:3001; media-src 'self' blob: http://localhost:3001; style-src 'self' 'unsafe-inline' http://localhost:3001; script-src 'self' http://localhost:3001"
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Datran",
        "width": 1000
      }
    ]
  }
}
