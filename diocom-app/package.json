{
  "name": "diocom-app",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "datran": "./bin/datran.js"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "node ../scripts/start-all.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "db:status": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db.mjs status",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@vercel/otel": "^2.1.3",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "next-auth": "^4.24.13",
    "pg": "^8.12.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "secrets.js-grempe": "^2.0.0",
    "sharp": "^0.34.5",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.4.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/busboy": "^1.5.5",
    "@types/node": "^20",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
