# Copy to .env.local and fill in. Never commit real values.

# --- Required in production ---
# Signs sessions, unlock cookies and lobby cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DIOCOM_SECRET=
NEXTAUTH_URL=http://localhost:3001
# postgres://user:password@localhost:5432/datran
DATABASE_URL=

# --- Shared state / multiple instances (src/lib/kv) ---
# Rate limits, single-use passkey login tokens, WebAuthn challenges, swarm signaling mailboxes, upload progress
# (SSE), cleanup/prefetch coordination. Unset = in-process memory: fine for dev and for ONE production instance
# (a prominent warning is logged in production). Set it to run several instances behind a load balancer.
# Requires Redis >= 6.2.
# REDIS_URL=redis://:password@localhost:6379/0
# Refuse to start without REDIS_URL (recommended once you scale out).
# REQUIRE_REDIS=false
# Key/channel namespace, e.g. to share one Redis between stacks.
# KV_PREFIX=diocom:

# --- Database (PostgreSQL; see deploy/README.md "Database") ---
# Schema = numbered migrations in ./migrations. Apply with `npm run db:migrate`, inspect with `npm run db:status`.
# Production (NODE_ENV=production) REQUIRES a reachable, fully migrated PostgreSQL and refuses to start otherwise.
# Apply pending migrations automatically on server start (advisory-locked; safe with several instances).
# DB_AUTO_MIGRATE=false
# DB_POOL_MAX=20
# DB_MIGRATE_LOCK_TIMEOUT_MS=120000
# DB_MIGRATIONS_DIR=./migrations
# Development/tests only: without DATABASE_URL (or if Postgres is down) a JSON emulator is used. It supports
# exactly the queries the app sends (src/db/localStore.ts) and throws on anything else. Ignored in production.
LOCAL_DB_PATH=./data/local_db.json

# --- Storage ---
# Where NEW uploads go: local (default) | s3 | reactor. Unset keeps the old rule (s3 if CDN_ENABLED=true, else local).
#   reactor = the Rust reactor's chunked object store (core-reactor/docs/NETWORK_SPEC.md §2): content-addressed,
#             deduplicated, compressed per chunk with evolved recipes, range reads; records get
#             storage_path "reactor:<sha256>". Needs REACTOR_URL/REACTOR_TOKEN. Thumbnails stay local (or S3 if
#             CDN_ENABLED=true). scripts/start-all sets reactor when it launches/finds a reactor, unless already set.
# Existing local/S3 files keep working whatever this is set to. Move local ones with
#   scripts/migrate_to_reactor_store.ts (see its header; --dry-run first).
# STORAGE_BACKEND=local
# REACTOR_STORE_TIMEOUT_MS=600000          # reactor store uploads / full reads (headers timeout = REACTOR_TIMEOUT_MS)
DIOCOM_STORAGE_PATH=./.storage
MAX_UPLOAD_BYTES=209715200
ALLOW_ANONYMOUS_UPLOADS=true
CLEANUP_INTERVAL_MS=900000
STREAM_CACHE_MAX_BYTES=268435456

# --- Access prediction & prefetch (core-reactor/docs/NETWORK_SPEC.md §5) ---
# Records (file, time, actor) per stream access (actor = user id or HMAC of IP+UA; raw IPs are never stored),
# learns recency/hour-of-week/sequence models and warms predicted files into the stream cache.
# PREDICT_ENABLED=true
PREDICT_RETENTION_DAYS=30
# PREDICT_MAX_EVENTS=500000                 # row cap for stored access events (oldest pruned by the cleanup job)
# PREDICT_WINDOW_MS=3600000                 # predictions are for the next window
# PREDICT_MIN_SCORE=0.2                     # min P(access in window) to predict/prefetch a file
# PREDICT_TZ_OFFSET_MINUTES=                # hour-of-week bins; default = the server's current UTC offset
# PREDICT_MAX_FILES=5000                    # files tracked by the model
# PREDICT_METRICS_WINDOW_MS=86400000        # rolling window for admin precision/recall/hit-rate/TTFB
# Periodic prefetch interval; 0 disables it.
PREFETCH_INTERVAL_MS=60000
# PREFETCH_MAX_BYTES=                       # default: 25% of STREAM_CACHE_MAX_BYTES
# Markov successors warmed on each access.
PREFETCH_SUCCESSORS=3
# PREFETCH_CONCURRENCY=2                    # parallel warm (read + decode) jobs
# PREFETCH_MAX_FILES=50                     # max files predicted per interval
# Optional S3 storage
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Rust reactor (core-reactor) ---
REACTOR_PORT=3005
# REACTOR_URL=http://127.0.0.1:3005
# Shared secret; must match the reactor's REACTOR_TOKEN. scripts/start-all generates one if unset.
REACTOR_TOKEN=
REACTOR_TIMEOUT_MS=30000

# --- Rust reactor: evolutionary compression (core-reactor/docs/EVOLUTION_SPEC.md) ---
# These are read by the reactor process (core-reactor), NOT by this app; set them in the reactor's
# environment. Exception: the app's TypeScript fallback decoder also reads REACTOR_STATE_DIR to find
# zstd dictionaries (<dir>/dicts/<sha256>.dict) when the reactor is down.
# REACTOR_STATE_DIR=./reactor-state          # populations, champions, dictionaries (relative to core-reactor/)
# REACTOR_BIND=127.0.0.1                     # non-loopback requires REACTOR_TOKEN and REACTOR_CLUSTER_TOKEN
# REACTOR_PEERS=                             # comma-separated peer base URLs, e.g. http://10.0.0.2:3005
# REACTOR_CLUSTER_TOKEN=                     # x-cluster-token for gossip; gossip disabled when unset
# REACTOR_SHARE_DICTIONARIES=false           # dictionaries contain fragments of user data
# REACTOR_EVOLVE=true                        # false freezes evolution (champions still used)
# REACTOR_WEIGHT_ENCODE=0.5                  # fitness penalty per encode second/MiB
# REACTOR_WEIGHT_DECODE=1.0                  # fitness penalty per decode second/MiB
# REACTOR_GOSSIP_INTERVAL_MS=60000
# REACTOR_EVOLVE_INTERVAL_MS=30000
# REACTOR_SAMPLE_BYTES_MAX=1048576           # per-sample prefix kept in memory for evolution

# --- Proxy ---
# Only set true behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# --- Passkeys ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
WEBAUTHN_RP_NAME=Datran

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Optional features ---
SWARM_CREDITS_ENABLED=false
SWARM_DAILY_CREDIT_CAP=
WEBHOOK_URL=
WEBHOOK_SECRET=
