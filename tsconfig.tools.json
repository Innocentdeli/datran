{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "outDir": "./dist/tools",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": false,
        "sourceMap": false
    },
    "include": [
        "src/tool/**/*",
        "src/core/**/*",
        "src/lib/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "diocom-app"
    ]
}