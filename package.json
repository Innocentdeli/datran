{
    "name": "autonomous-compression-swarm",
    "version": "1.0.0",
    "description": "A self-optimizing, evolutionary compression network.",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "build:tools": "tsc --project tsconfig.tools.json",
        "watch:tools": "tsc --project tsconfig.tools.json --watch",
        "start": "node dist/index.js",
        "simulate": "ts-node src/simulation/run_evolution.ts"
    },
    "keywords": [
        "compression",
        "evolutionary",
        "swarm",
        "p2p"
    ],
    "author": "Antigravity",
    "license": "MIT",
    "dependencies": {
        "zstd-codec": "^0.1.4",
        "brotli": "^1.3.3",
        "lz4js": "^0.2.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "ts-node": "^10.9.1",
        "@types/node": "^18.0.0"
    }
}