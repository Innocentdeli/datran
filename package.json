{
    "name": "autonomous-compression-swarm",
    "version": "1.0.0",
    "description": "A self-optimizing, evolutionary compression network: reactors evolve per-content-type compression recipes on real data and share them with peers.",
    "scripts": {
        "start:all": "node scripts/start-all.js",
        "dev:all": "node scripts/start-all.js",
        "build": "tsc",
        "build:tools": "tsc --project tsconfig.tools.json",
        "watch:tools": "tsc --project tsconfig.tools.json --watch",
        "start": "node scripts/start-all.js",
        "simulate": "ts-node src/simulation/run_evolution.ts",
        "test": "node --require ts-node/register/transpile-only --test \"tests/**/*.test.ts\""
    },
    "keywords": [
        "compression",
        "evolutionary",
        "swarm",
        "p2p"
    ],
    "author": "Antigravity",
    "license": "MIT",
    "dependencies": {
        "zstd-codec": "^0.1.4",
        "brotli": "^1.3.3",
        "lz4js": "^0.2.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "ts-node": "^10.9.1",
        "@types/node": "^18.0.0"
    }
}