# Copy to deploy/.env (never commit it). Used by docker-compose.yml both for variable
# substitution (--env-file) and as the app container's env_file. See
# diocom-app/.env.example for every app setting; the essentials for this stack are below.

# --- Edge (Caddy) ---
SITE_ADDRESS=datran.example.com
APP_PORT=3000
# Keep slightly above MAX_UPLOAD_BYTES (multipart overhead). 200 MiB -> 201MiB.
INGEST_MAX_BODY=201MiB
DEFAULT_MAX_BODY=16MiB

# --- App ---
NEXTAUTH_URL=https://datran.example.com
WEBAUTHN_RP_ID=datran.example.com
WEBAUTHN_ORIGIN=https://datran.example.com
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DIOCOM_SECRET=

# --- PostgreSQL (mandatory in production; internal network only) ---
# Password for the bundled `postgres` service (generate like DIOCOM_SECRET). The app container
# runs `npm run db:migrate` before starting. Leave DATABASE_URL empty to use the bundled service,
# or point it at an external server: postgres://user:pass@host:5432/datran
POSTGRES_PASSWORD=
DATABASE_URL=
MAX_UPLOAD_BYTES=209715200
# Resumable (tus) uploads: partial uploads live here until complete (outside the upload storage).
# With more than one app instance this MUST be shared storage (same volume/NFS on every instance).
UPLOAD_STAGING_DIR=/data/app/upload-staging
# Unfinished uploads idle this long are deleted by the cleanup job.
UPLOAD_EXPIRY_HOURS=24
STORAGE_BACKEND=reactor

# --- Redis (shared multi-instance state; internal network only) ---
# URL-safe secret, generate like DIOCOM_SECRET. docker-compose builds REDIS_URL from it.
REDIS_PASSWORD=
# REDIS_MAXMEMORY=256mb

# --- Reactor (shared by app and reactor; generate both like DIOCOM_SECRET) ---
REACTOR_TOKEN=
REACTOR_CLUSTER_TOKEN=
# Encryption at rest, required. Generate: openssl rand -base64 32
# Keep it safe and separate from backups: without it, stored files cannot be read.
REACTOR_MASTER_KEY=
# speed | balanced | ratio
# REACTOR_PROFILE=balanced
# Bearer token for Prometheus scraping the reactor's /metrics (observability profile)
REACTOR_METRICS_TOKEN=
# Host directory for reactor backups (deploy/backup.sh)
# REACTOR_BACKUP_HOST_DIR=./backups/reactor
# Optional multi-node cluster (reactors talk directly over their own TLS, not via Caddy):
# REACTOR_PEERS=https://10.0.0.2:3005
# REACTOR_TLS_CERT=/data/reactor-state/tls/cert.pem
# REACTOR_TLS_KEY=/data/reactor-state/tls/key.pem
# REACTOR_TLS_CA=/data/reactor-state/tls/ca.pem

# --- Observability (diocom-app/src/lib/observability; see README "Observability") ---
# LOG_LEVEL=info                       # trace|debug|info|warn|error|fatal|silent (JSON logs in production)
# Bearer token for GET /api/metrics (unset = endpoint disabled). Generate like DIOCOM_SECRET.
METRICS_TOKEN=
# OpenTelemetry traces over OTLP (unset = tracing off):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20xyz
# OTEL_SERVICE_NAME=diocom-app
# `--profile observability` (Prometheus + Grafana on 127.0.0.1:${GRAFANA_PORT:-3001}):
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3001
# PROMETHEUS_RETENTION=15d
