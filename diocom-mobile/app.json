{
  "expo": {
    "name": "Datran",
    "slug": "datran-mobile",
    "version": "1.0.0",
    "scheme": "datran",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datran.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.datran.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "datran"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "*/*"
            }
          ],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "*/*"
            }
          ],
          "category": ["DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
